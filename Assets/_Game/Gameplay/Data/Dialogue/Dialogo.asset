  m_Script: {fileID: 11500000, guid: 6f9476a5350d0554c976acefd0ed02ab, type: 3}
  m_Name: Dialogo
  m_EditorClassIdentifier: Assembly-CSharp::Game.Shared.Dialogue.DialogueData
  Lines:
  - Text: Welcome to my resting hall, traveler. My name is Mark. How can I help you?
    Character: {fileID: 11400000, guid: c9e52615242e0c441ad0aa2005d1237a, type: 2}
  - Text: "Hello, I\u2019m looking for the totem... or portal. Do you know where
      it is?"
    Character: {fileID: 11400000, guid: b98df9e62029b69459f61cac13833016, type: 2}
  - Text: "Of course. It\u2019s located at the upper part of the hall. Go there and
      you will find it."
    Character: {fileID: 11400000, guid: c9e52615242e0c441ad0aa2005d1237a, type: 2}
